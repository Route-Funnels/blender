$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
if ([enum]::GetNames([Net.SecurityProtocolType]) -contains "Tls13") {
  [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls13
}

function Write-Log($Message) {
  $stamp = Get-Date -Format o
  Write-Host "[$stamp] $Message"
}

function Add-ToMachinePath($PathToAdd) {
  $machinePath = [Environment]::GetEnvironmentVariable("Path", "Machine")
  if ($machinePath -notlike "*$PathToAdd*") {
    [Environment]::SetEnvironmentVariable("Path", "$machinePath;$PathToAdd", "Machine")
  }
  $env:Path = [Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [Environment]::GetEnvironmentVariable("Path", "User")
}

function Invoke-DownloadWithRetry($Uri, $OutFile, $Attempts = 5) {
  for ($attempt = 1; $attempt -le $Attempts; $attempt++) {
    try {
      Write-Log "Downloading $Uri (attempt $attempt/$Attempts)"
      Invoke-WebRequest -Uri $Uri -OutFile $OutFile -UseBasicParsing -Headers @{ "User-Agent" = "CodeTether-Blender-Windows-Build" }
      if ((Test-Path $OutFile) -and ((Get-Item $OutFile).Length -gt 0)) { return }
      throw "Download produced an empty file: $OutFile"
    }
    catch {
      if ($attempt -eq $Attempts) { throw }
      $delay = [Math]::Min(60, 5 * $attempt)
      Write-Log "Download failed: $($_.Exception.Message); retrying in $delay seconds"
      Start-Sleep -Seconds $delay
    }
  }
}

function ConvertTo-CmdArgument([string]$Value) {
  # Quote for cmd.exe. Escape cmd metacharacters first, then double embedded
  # quotes for Windows command-line parsing.
  $escaped = $Value -replace '([\^&|<>()])', '^$1'
  $escaped = $escaped -replace '"', '""'
  return '"' + $escaped + '"'
}

function Invoke-LoggedCommand {
  param(
    [Parameter(Mandatory=$true)][string]$FilePath,
    [Parameter(ValueFromRemainingArguments=$true)][string[]]$Arguments
  )

  Write-Log "> $FilePath $($Arguments -join ' ')"

  # Do not use PowerShell native stderr redirection (`2>&1`) here. With
  # $ErrorActionPreference='Stop', Windows PowerShell converts native stderr
  # lines (including gcloud's normal progress text) into terminating errors.
  # Redirect through ProcessStartInfo files instead, then replay the captured
  # text into the transcript/log. Run through cmd.exe for every tool so command
  # shims such as gcloud.cmd, extensionless wrappers, and .bat files all work;
  # Start-Process cannot execute those reliably as native Win32 applications.
  $stdout = [System.IO.Path]::GetTempFileName()
  $stderr = [System.IO.Path]::GetTempFileName()
  $cmdScript = [System.IO.Path]::ChangeExtension([System.IO.Path]::GetTempFileName(), ".cmd")
  try {
    $resolvedPath = $FilePath
    $resolved = Get-Command $FilePath -ErrorAction SilentlyContinue
    if ($resolved -and $resolved.Source) { $resolvedPath = $resolved.Source }

    # PowerShell may resolve command shims to extensionless files or .ps1 files,
    # which cmd.exe cannot execute with `call`. Prefer the corresponding .cmd
    # shim when present (notably for Google Cloud SDK's gcloud.cmd).
    if ($resolvedPath -notmatch '\.(exe|cmd|bat)$') {
      $cmdCandidate = "$resolvedPath.cmd"
      if (Test-Path $cmdCandidate) { $resolvedPath = $cmdCandidate }
    }
    if ($FilePath -eq "gcloud") {
      $gcloudCandidates = @(
        "C:\Program Files\Google\Cloud SDK\google-cloud-sdk\bin\gcloud.cmd",
        "C:\Program Files (x86)\Google\Cloud SDK\google-cloud-sdk\bin\gcloud.cmd"
      )
      foreach ($candidate in $gcloudCandidates) {
        if (Test-Path $candidate) { $resolvedPath = $candidate; break }
      }
    }
    Write-Log "Resolved command path: $FilePath -> $resolvedPath"

    # Use `call` so .cmd/.bat shims (notably gcloud.cmd) execute correctly,
    # and avoid `cmd /s` because it strips quotes around paths such as
    # `C:\Program Files\...\gcloud.cmd` in this invocation shape.
    $cmdLine = 'call ' + (ConvertTo-CmdArgument $resolvedPath)
    foreach ($arg in $Arguments) {
      $cmdLine += ' ' + (ConvertTo-CmdArgument $arg)
    }

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = "cmd.exe"
    [System.IO.File]::WriteAllText($cmdScript, "@echo off`r`n$cmdLine`r`nexit /b %ERRORLEVEL%`r`n")
    $psi.Arguments = "/d /c " + (ConvertTo-CmdArgument $cmdScript)
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $process = [System.Diagnostics.Process]::Start($psi)
    $stdOutText = $process.StandardOutput.ReadToEnd()
    $stdErrText = $process.StandardError.ReadToEnd()
    $process.WaitForExit()
    [System.IO.File]::WriteAllText($stdout, $stdOutText)
    [System.IO.File]::WriteAllText($stderr, $stdErrText)

    if (Test-Path $stdout) { Get-Content $stdout -ErrorAction SilentlyContinue | ForEach-Object { Write-Host $_ } }
    if (Test-Path $stderr) { Get-Content $stderr -ErrorAction SilentlyContinue | ForEach-Object { Write-Host $_ } }
    $exitCode = $process.ExitCode
    if ($exitCode -ne 0) {
      throw "Command failed with exit code ${exitCode}: $FilePath $($Arguments -join ' ')"
    }
  }
  finally {
    Remove-Item $stdout, $stderr -Force -ErrorAction SilentlyContinue
    Remove-Item $cmdScript -Force -ErrorAction SilentlyContinue
  }
}

function Get-GceAccessToken {
  $metadataHeaders = @{ "Metadata-Flavor" = "Google" }
  $tokenResponse = Invoke-RestMethod `
    -Uri "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" `
    -Headers $metadataHeaders `
    -UseBasicParsing
  return $tokenResponse.access_token
}

function Split-GcsUri([string]$Uri) {
  if ($Uri -notmatch '^gs://([^/]+)/(.+)$') { throw "Invalid GCS URI: $Uri" }
  return @{ Bucket = $Matches[1]; Object = $Matches[2] }
}

function Copy-FromGcs($Source, $Destination) {
  $parts = Split-GcsUri $Source
  $token = Get-GceAccessToken
  $encodedObject = [System.Uri]::EscapeDataString($parts.Object)
  $url = "https://storage.googleapis.com/storage/v1/b/$($parts.Bucket)/o/$encodedObject?alt=media"
  Write-Log "Downloading $Source to $Destination"
  Invoke-WebRequest `
    -Uri $url `
    -OutFile $Destination `
    -Headers @{ Authorization = "Bearer $token"; "User-Agent" = "CodeTether-Blender-Windows-Build" } `
    -UseBasicParsing
  if (-not (Test-Path $Destination)) { throw "GCS download did not create $Destination" }
}

function Copy-ToGcs($Source, $Destination) {
  if (-not (Test-Path $Source)) { throw "Cannot upload missing file: $Source" }
  $parts = Split-GcsUri $Destination
  $token = Get-GceAccessToken
  $encodedObject = [System.Uri]::EscapeDataString($parts.Object)
  $url = "https://storage.googleapis.com/upload/storage/v1/b/$($parts.Bucket)/o?uploadType=media&name=$encodedObject"
  Write-Log "Uploading $Source to $Destination"
  Invoke-WebRequest `
    -Uri $url `
    -Method Post `
    -InFile $Source `
    -ContentType "application/octet-stream" `
    -Headers @{ Authorization = "Bearer $token"; "User-Agent" = "CodeTether-Blender-Windows-Build" } `
    -UseBasicParsing | Out-Null
}

function Copy-ToGcsBestEffort($Source, $Destination) {
  try {
    if (Test-Path $Source) {
      try {
        Copy-ToGcs $Source $Destination
      }
      catch {
        Write-Log "WARNING: failed to upload ${Source}: $($_.Exception.Message)"
      }
    }
  }
  catch {
    Write-Log "WARNING: unexpected upload helper error for ${Source}: $($_.Exception.Message)"
  }
}

$BuildId = "__BUILD_ID__"
$ArtifactBucket = "__ARTIFACT_BUCKET__"
$RepoUrl = "__REPO_URL__"
$BaseRef = "__BASE_REF__"
$BuildArgs = "__BUILD_ARGS__"
$WorkDir = "C:\blender-agent-build"
$SourceDir = Join-Path $WorkDir "blender-src"
$OverlayArchive = Join-Path $WorkDir "agent-overlay.tar.gz"
$ArtifactDir = Join-Path $WorkDir "artifacts"
$Transcript = Join-Path $WorkDir "windows-build-transcript.txt"

New-Item -ItemType Directory -Force -Path $WorkDir, $ArtifactDir | Out-Null
Start-Transcript -Path $Transcript -Force | Out-Null

try {
  Write-Log "Installing build tooling with winget/chocolatey/direct installers as needed"

  if (-not (Get-Command git.exe -ErrorAction SilentlyContinue)) {
    Write-Log "Installing Git"
    $gitInstaller = Join-Path $WorkDir "Git-64-bit.exe"
    Invoke-DownloadWithRetry "https://github.com/git-for-windows/git/releases/download/v2.51.2.windows.1/Git-2.51.2-64-bit.exe" $gitInstaller
    Start-Process -FilePath $gitInstaller -ArgumentList "/VERYSILENT", "/NORESTART", "/NOCANCEL", "/SP-" -Wait
    Add-ToMachinePath "C:\Program Files\Git\cmd"
  }

  if (-not (Get-Command cmake.exe -ErrorAction SilentlyContinue)) {
    Write-Log "Installing CMake"
    $cmakeMsi = Join-Path $WorkDir "cmake.msi"
    Invoke-DownloadWithRetry "https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-windows-x86_64.msi" $cmakeMsi
    Start-Process msiexec.exe -ArgumentList "/i", $cmakeMsi, "/qn", "/norestart", "ADD_CMAKE_TO_PATH=System" -Wait
    Add-ToMachinePath "C:\Program Files\CMake\bin"
  }

  if (-not (Get-Command ninja.exe -ErrorAction SilentlyContinue)) {
    Write-Log "Installing Ninja"
    $ninjaZip = Join-Path $WorkDir "ninja-win.zip"
    $ninjaDir = "C:\ninja"
    Invoke-DownloadWithRetry "https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-win.zip" $ninjaZip
    New-Item -ItemType Directory -Force -Path $ninjaDir | Out-Null
    Expand-Archive -Path $ninjaZip -DestinationPath $ninjaDir -Force
    Add-ToMachinePath $ninjaDir
  }

  $vswhere = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
  $hasVS = (Test-Path $vswhere) -and (& $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath)
  if (-not $hasVS) {
    Write-Log "Installing Visual Studio 2022 Build Tools"
    $vsInstaller = Join-Path $WorkDir "vs_buildtools.exe"
    Invoke-DownloadWithRetry "https://aka.ms/vs/17/release/vs_BuildTools.exe" $vsInstaller
    Start-Process -FilePath $vsInstaller -ArgumentList @(
      "--quiet", "--wait", "--norestart", "--nocache",
      "--add", "Microsoft.VisualStudio.Workload.VCTools",
      "--add", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
      "--add", "Microsoft.VisualStudio.Component.Windows11SDK.22621"
    ) -Wait
  }

  Write-Log "Downloading agent overlay from GCS"
  Copy-FromGcs "$ArtifactBucket/$BuildId/agent-overlay.tar.gz" $OverlayArchive

  Write-Log "Cloning Blender source"
  Invoke-LoggedCommand git config --global core.longpaths true
  Invoke-LoggedCommand git lfs install --skip-smudge
  Invoke-LoggedCommand git clone --filter=blob:none $RepoUrl $SourceDir
  Invoke-LoggedCommand git -C $SourceDir checkout $BaseRef
  Invoke-LoggedCommand git -C $SourceDir submodule update --init --depth 1 scripts/addons_core

  Write-Log "Fetching Windows dependency libraries non-interactively"
  Invoke-LoggedCommand git -C $SourceDir config --local submodule.lib/windows_x64.update checkout
  $env:GIT_LFS_SKIP_SMUDGE = "1"
  Invoke-LoggedCommand git -C $SourceDir submodule update --progress --init lib/windows_x64
  Remove-Item Env:\GIT_LFS_SKIP_SMUDGE -ErrorAction SilentlyContinue
  Invoke-LoggedCommand git -C (Join-Path $SourceDir "lib/windows_x64") lfs pull

  Write-Log "Applying agent overlay"
  tar -xzf $OverlayArchive -C $SourceDir

  Write-Log "Skipping make.bat update because lib/windows_x64 was fetched explicitly above"
  Push-Location $SourceDir

  Write-Log "Building Blender with args: $BuildArgs"
  Invoke-LoggedCommand cmd.exe /c "make.bat $BuildArgs"
  Pop-Location

  $Exe = Get-ChildItem -Path "C:\" -Filter blender.exe -Recurse -ErrorAction SilentlyContinue |
    Where-Object { $_.FullName -match "build_windows.*bin|build_windows.*Release|build_windows.*install" } |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1
  if (-not $Exe) {
    $Exe = Get-ChildItem -Path (Join-Path $SourceDir "..") -Filter blender.exe -Recurse -ErrorAction SilentlyContinue |
      Sort-Object LastWriteTime -Descending |
      Select-Object -First 1
  }
  if (-not $Exe) { throw "Could not locate blender.exe after build" }

  Write-Log "Found blender.exe at $($Exe.FullName)"
  $Smoke = Join-Path $ArtifactDir "agent_mcp_smoke_test_windows.json"
  '{"jsonrpc":"2.0","id":1,"method":"status","params":{}}' |
    & $Exe.FullName --background --agent-mcp | Tee-Object -FilePath $Smoke
  if (-not (Select-String -Path $Smoke -Pattern '"blender_version"' -Quiet)) {
    throw "Agent MCP smoke test did not report blender_version"
  }

  $PackageRoot = Join-Path $ArtifactDir "blender-agent-mcp-windows-x64"
  New-Item -ItemType Directory -Force -Path $PackageRoot | Out-Null
  $BinDir = $Exe.Directory.FullName
  Write-Log "Packaging from $BinDir"
  Copy-Item -Path (Join-Path $BinDir "*") -Destination $PackageRoot -Recurse -Force
  Copy-Item -Path $Smoke -Destination $PackageRoot -Force
  Copy-Item -Path (Join-Path $SourceDir "tools\codetether_blender_automation.py") -Destination (Join-Path $PackageRoot "codetether_blender_automation.py") -Force

  $ZipPath = Join-Path $ArtifactDir "blender-agent-mcp-windows-x64.zip"
  Compress-Archive -Path (Join-Path $PackageRoot "*") -DestinationPath $ZipPath -Force
  Copy-ToGcs $ZipPath "$ArtifactBucket/$BuildId/blender-agent-mcp-windows-x64.zip"
  Copy-ToGcs $Smoke "$ArtifactBucket/$BuildId/agent_mcp_smoke_test_windows.json"

  Write-Log "WINDOWS_BUILD_SUCCESS artifact=$ArtifactBucket/$BuildId/blender-agent-mcp-windows-x64.zip"
}
catch {
  Write-Log "WINDOWS_BUILD_FAILED $($_.Exception.Message)"
  throw
}
finally {
  try { Stop-Transcript | Out-Null } catch {}
  Copy-ToGcsBestEffort $Transcript "$ArtifactBucket/$BuildId/windows-build-transcript.txt"
}
